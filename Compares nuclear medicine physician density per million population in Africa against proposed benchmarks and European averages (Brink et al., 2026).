# Description: Nuclear Medicine Physician Density — Africa vs. Europe (Brink et al., 2026)
# ==============================================================================

import matplotlib.pyplot as plt

regions = [
    'Africa\n(current)',
    'Proposed\nbenchmark',
    'Europe\n(current)'
]
density = [0.18, 1.0, 3.1]
colors  = ['#C44E52', '#DD8452', '#4C72B0']

fig, ax = plt.subplots(figsize=(9, 6))
bars = ax.bar(regions, density, color=colors,
              edgecolor='black', width=0.45)

ax.set_ylabel('Nuclear Medicine Physicians per Million Population',
              fontsize=13)
ax.set_title('Nuclear Medicine Physician Density\nAfrica vs Proposed Benchmark vs Europe '
             '(Brink et al., 2026)',
             fontsize=14, fontweight='bold', pad=12)
ax.set_ylim(0, 3.8)
ax.yaxis.grid(True, alpha=0.3)
ax.tick_params(axis='x', labelsize=13)
ax.tick_params(axis='y', labelsize=12)

for bar, val in zip(bars, density):
    ax.text(bar.get_x() + bar.get_width()/2,
            bar.get_height() + 0.07,
            f'{val:.2f}', ha='center', va='bottom',
            fontsize=14, fontweight='bold')

ax.text(0.5, -0.12,
        'Source: Brink et al. (2026). '
        'Journal of Nuclear Medicine, 67(2), 196–203.',
        ha='center', transform=ax.transAxes,
        fontsize=10, style='italic', color='gray')

plt.tight_layout()
plt.savefig('figure4_5_physician_density.png', dpi=300, bbox_inches='tight')
plt.show()
