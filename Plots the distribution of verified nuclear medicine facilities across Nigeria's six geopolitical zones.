# ==============================================================================
# Script: figure4_4.py
# Description: Facilities Named in Verified Literature by Geopolitical Zone
# ==============================================================================

import matplotlib.pyplot as plt
import numpy as np

zones = [
    'Southwest', 'North\nCentral', 'Northwest',
    'Southeast', 'Northeast', 'South-South'
]

functional  = [3, 1, 1, 0, 0, 0]
developing  = [0, 1, 0, 0, 0, 0]

x = np.arange(len(zones))
width = 0.35

fig, ax = plt.subplots(figsize=(12, 7))
bars1 = ax.bar(x - width/2, functional, width,
               label='Functional (named in literature)',
               color='#4C72B0', edgecolor='black')
bars2 = ax.bar(x + width/2, developing, width,
               label='Under development',
               color='#DD8452', edgecolor='black')

ax.set_xlabel('Geopolitical Zone', fontsize=14)
ax.set_ylabel('Number of Facilities', fontsize=14)
ax.set_title('Nuclear Medicine Facilities Named in Verified Literature\nby Geopolitical Zone',
             fontsize=15, fontweight='bold', pad=12)
ax.set_xticks(x)
ax.set_xticklabels(zones, fontsize=13)
ax.tick_params(axis='y', labelsize=12)
ax.legend(fontsize=13)
ax.set_yticks([0, 1, 2, 3, 4])
ax.yaxis.grid(True, alpha=0.3)

for bar in bars1:
    if bar.get_height() > 0:
        ax.text(bar.get_x() + bar.get_width()/2,
                bar.get_height() + 0.05,
                str(int(bar.get_height())),
                ha='center', va='bottom',
                fontsize=13, fontweight='bold')
for bar in bars2:
    if bar.get_height() > 0:
        ax.text(bar.get_x() + bar.get_width()/2,
                bar.get_height() + 0.05,
                str(int(bar.get_height())),
                ha='center', va='bottom',
                fontsize=13, fontweight='bold')

ax.text(0.5, -0.13,
        'Source: NNRA public statements; MeCure/NNRA coverage; '
        'Taiwo & Orunmuyi (2021).\n'
        'Note: This chart reflects facilities named in accessible '
        'literature only, not a national census.',
        ha='center', transform=ax.transAxes,
        fontsize=10, style='italic', color='gray')

plt.tight_layout()
plt.savefig('figure4_4_facility_distribution.png',
            dpi=300, bbox_inches='tight')
plt.show()
