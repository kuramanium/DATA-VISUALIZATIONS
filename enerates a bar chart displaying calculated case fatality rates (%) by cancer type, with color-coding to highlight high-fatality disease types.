# Script: figure4_2.py
# Description: Case Fatality Rate by Cancer Type, Nigeria (GLOBOCAN 2022)
# ==============================================================================

import matplotlib.pyplot as plt
import numpy as np

cancer_types = [
    'Breast', 'Prostate', 'Cervix\nuteri',
    'Colorectum', 'Liver', 'All others'
]
new_cases = [32278, 18019, 13676, 8114, 4382, 51294]
deaths    = [16332, 11443,  7093, 5912, 4252, 34510]
fatality_rate = [d / c * 100 for c, d in zip(new_cases, deaths)]

colors = ['#4C72B0' if r < 70 else '#C44E52' for r in fatality_rate]

fig, ax = plt.subplots(figsize=(11, 6))
bars = ax.bar(cancer_types, fatality_rate,
              color=colors, edgecolor='black', width=0.5)

ax.set_ylabel('Case Fatality Rate (%)', fontsize=14)
ax.set_title('Case Fatality Rate by Cancer Type, Nigeria\n(GLOBOCAN 2022)',
             fontsize=16, fontweight='bold', pad=12)
ax.set_xticklabels(cancer_types, fontsize=12)
ax.tick_params(axis='y', labelsize=12)
ax.set_ylim(0, 110)
ax.yaxis.grid(True, alpha=0.3)
ax.axhline(y=50, color='gray', linestyle='--',
           linewidth=1, alpha=0.6, label='50% reference line')
ax.legend(fontsize=12)

for bar, rate in zip(bars, fatality_rate):
    ax.text(bar.get_x() + bar.get_width()/2,
            bar.get_height() + 2,
            f'{rate:.1f}%', ha='center', va='bottom',
            fontsize=12, fontweight='bold')

ax.text(0.5, -0.12,
        'Source: IARC GLOBOCAN 2022. '
        'Case fatality rates calculated by the author.',
        ha='center', transform=ax.transAxes,
        fontsize=10, style='italic', color='gray')

plt.tight_layout()
plt.savefig('figure4_2_fatality_rate.png', dpi=300, bbox_inches='tight')
plt.show()
